    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "^1.1.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.102.0"
  }
